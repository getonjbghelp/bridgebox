# Python
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
backend/*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/

# Runtime data / secrets - never commit
logs/
certs/
# paths.temp_dir - where the zapret updater downloads and stages a release
# (winws.exe, WinDivert64.sys, the .bin payloads, the release zip). All of it
# is fetched from Flowseal on demand and regenerated, never edited by hand.
temp/

# Graphify knowledge-graph output (regenerable)
graphify-out/
baseline.json

# tools/build_portable.py's output - PyInstaller's work/spec scratch space
# and the assembled BridgeBox_Portable/ release (tens of MB, regenerated by
# running the script, never something to commit).
/build/
/dist/
