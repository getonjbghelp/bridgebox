# Python
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
backend/*.egg-info/

# Frontend
frontend/node_modules/
frontend/dist/

# Runtime data / secrets - never commit
logs/
certs/

# paths.temp_dir - where the zapret updater downloads and stages a release
# (winws.exe, WinDivert64.sys, the .bin payloads, the release zip). All of it
# is fetched from Flowseal on demand and regenerated, never edited by hand.
temp/

# Graphify knowledge-graph output (regenerable)
graphify-out/
baseline.json
steam_launch_backup.json
other_launch_backup.json

# tools/build_portable.py's output - PyInstaller's work/spec scratch space
# and the assembled BridgeBox_Portable/ release (tens of MB, regenerated by
# running the script, never something to commit).
/build/
/dist/

# A full copy of this same tree, for browsing/publishing as the public
# GitHub repo content - regenerated on demand, never nested into its own
# source (committing it would duplicate the entire repo inside itself).
/githubpubliccode/

# tgbot - internal Telegram release-announcer bot (see tgbot/README.md).
# Secrets and runtime state never get committed, even to the private repo.
tgbot/.env
tgbot/state/
tgbot/.venv/
